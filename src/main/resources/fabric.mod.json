  "authors": [
    "sinkie114"
  ],
  "license": "CC0-1.0",
  "icon": "assets/block-maker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.sinkie114.blockmaker.client.BlockMakerClient"
    ],
    "modmenu": [
      "com.sinkie114.blockmaker.client.compat.BlockMakerModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
